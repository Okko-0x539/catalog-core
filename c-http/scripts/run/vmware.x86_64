#!/bin/sh

if test ! -f "workdir/build/c-http_vmware-x86_64"; then
    echo "No kernel file workdir/build/c-http_vmware-x86_64." 1>&2
    echo "Did you run ./build.vmware.x86_64 ?" 1>&2
    exit 1
fi

# Configure VMware virtual network
if grep -q "VNET_9" "/etc/vmware/networking"; then
    echo "Info: 'VNET_9' configuration already exists in /etc/vmware/networking."
else
    sudo vmware-networks --stop
    echo "answer VNET_9_DHCP no" | sudo tee -a /etc/vmware/networking > /dev/null
    echo "answer VNET_9_HOSTONLY_NETMASK 255.255.255.0" | sudo tee -a /etc/vmware/networking > /dev/null
    echo "answer VNET_9_HOSTONLY_SUBNET 172.44.0.0" | sudo tee -a /etc/vmware/networking > /dev/null
    echo "answer VNET_9_NAT yes" | sudo tee -a /etc/vmware/networking > /dev/null
    echo "answer VNET_9_VIRTUAL_ADAPTER yes" | sudo tee -a /etc/vmware/networking > /dev/null
    echo "Configuration for 'VNET_9' has been successfully added to /etc/vmware/networking."
    sudo vmware-networks --start
fi

# Configure kernel command line
echo 'c-http netdev.ip=172.44.0.2/24:172.44.0.1::: -- ' > "workdir/build/kernel.cmdline"

# Create ISO image
../repos/unikraft/support/scripts/mkukimg -f iso -k workdir/build/c-http_vmware-x86_64 -a X64 -p vmware -b grub -c workdir/build/kernel.cmdline -o workdir/build/c-http_vmware-x86_64.iso

# Create VMware VMX config file
cat > "workdir/build/Unikraft.vmx" <<EOL
.encoding = "UTF-8"
config.version = "8"
virtualHW.version = "16"


displayName = "Unikraft"
numvcpus = "4"
memsize = "256"
guestOS = "other-64"

ide0:0.present = "TRUE"
ide0:0.deviceType = "cdrom-image"
ide0:0.fileName = "$PWD\workdir\build\c-http_vmware-x86_64.iso"

floppy0.present = "FALSE"

pciBridge0.present = "TRUE"
pciBridge0.virtualDev = "pcieRootPort"

ethernet0.present = "TRUE"
ethernet0.virtualDev = "vmxnet3"
ethernet0.connectionType = "custom"
ethernet0.vnet = "/dev/vmnet9"

EOL

vmrun -T ws start "workdir/build/Unikraft.vmx"
